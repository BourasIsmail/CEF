# Copier ce fichier en « .env » (jamais committé) puis remplacer chaque « change-me ».
# Générer un mot de passe robuste :  openssl rand -base64 24

# --- MySQL ---------------------------------------------------------------
MYSQL_DATABASE=cef_manager
MYSQL_USER=cef
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

# --- Backend ---------------------------------------------------------------
# dev  = migrations + jeu de données fictif (db/seed-dev) + Swagger
# prod = migrations uniquement
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# Origines autorisées par le CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Sécurité (utilisé à l'étape « sécurité ») ------------------------------
# Secret de signature des JWT : openssl rand -base64 48
# JWT_SECRET=change-me
