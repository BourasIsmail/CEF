# Copier ce fichier en « .env » (jamais committé) puis remplacer chaque « change-me ».
# Générer un mot de passe robuste :  openssl rand -base64 24

# --- Base de données (MySQL 8) ------------------------------------------------
# Le backend se connecte à la base indiquée ici ; Flyway y crée / met à jour le schéma au démarrage
# (le compte doit donc avoir les droits CREATE / ALTER / INDEX / REFERENCES / INSERT / UPDATE / DELETE / SELECT).
# Exemple (base distante) :
DB_URL=jdbc:mysql://HOTE:3306/NOM_BASE?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=change-me
DB_PASSWORD=change-me
# Option : MySQL local dans Docker (docker compose --profile localdb ...). Dans ce cas :
#   DB_URL=jdbc:mysql://db:3306/cef_manager?connectionTimeZone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
#   DB_USERNAME=cef  et  DB_PASSWORD=<même valeur que MYSQL_PASSWORD>
MYSQL_DATABASE=cef_manager
MYSQL_USER=cef
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

# --- Backend ---------------------------------------------------------------
# dev  = migrations + jeu de données fictif (db/seed-dev) + Swagger
# prod = migrations uniquement
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# Origine PUBLIQUE du frontend (le backend refuse les requêtes dont l'en-tête Origin est inconnu).
# Plusieurs origines : séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3000
# Le navigateur ne parle qu'au frontend : /api est relayé vers le backend (réseau interne).

# --- Sécurité ---------------------------------------------------------------
# Secret de signature des JWT (32 octets minimum) : openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-bytes
# Compte administrateur créé au premier démarrage, uniquement si la table des utilisateurs est vide. Connexion par e-mail.
# Mot de passe : 12 à 64 caractères, au moins une lettre et un chiffre. À retirer une fois connecté.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-me-1234
# Cookies d'authentification « Secure » (HTTPS). À mettre à false uniquement en développement local en HTTP.
COOKIE_SECURE=true
# Durées (ISO-8601) : jeton d'accès et jeton de rafraîchissement
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
